 use crate::receiver::ReceiveCache;
 
+type ProbeKey = (IpAddr, u16, u16, u8, u8);
+
+fn probe_key(probe: &Probe) -> ProbeKey {
+    let protocol = match probe.protocol {
+        L4::ICMP => 1,
+        L4::UDP => 17,
+        L4::ICMPv6 => 58,
+    };
+    let dst_port = if protocol == 17 { probe.dst_port } else { 0 };
+    (probe.dst_addr, probe.src_port, dst_port, probe.ttl, protocol)
+}
+
+fn reply_matches_probes(reply: &Reply, sent: &HashSet<ProbeKey>, instance_id: u16) -> bool {
+    reply.is_valid(instance_id) && sent.contains(&(
+        reply.probe_dst_addr, reply.probe_src_port, reply.probe_dst_port,
+        reply.probe_ttl, reply.probe_protocol,
+    ))
+}
+
 pub fn probe<T: Iterator<Item = Probe>>(config: Config, probes: T) -> Result<Vec<Reply>> {
+    // The capture interface also sees unrelated pings and other measurements.
+    let probes: Vec<Probe> = probes.collect();
+    let sent: HashSet<ProbeKey> = probes.iter().map(probe_key).collect();
+    let instance_id = config.instance_id;
