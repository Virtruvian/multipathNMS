+#[cfg(test)]
+mod nms_tests {
+    use super::*;
+    use crate::helpers::reply;
+
+    #[test]
+    fn nms_reply_filter_rejects_foreign_measurements_and_bad_checksums() {
+        let instance_id = 1234;
+        let destination: IpAddr = "8.8.8.8".parse().unwrap();
+        let probe = Probe { dst_addr: destination, src_port: 24000,
+            dst_port: 33434, ttl: 3, protocol: L4::ICMP };
+        let sent = HashSet::from([probe_key(&probe)]);
+        let mut observation = reply(3, "10.0.0.1", "8.8.8.8");
+        observation.probe_src_port = 24000;
+        observation.probe_dst_port = 0;
+        observation.probe_id = probe.checksum(instance_id);
+        assert!(reply_matches_probes(&observation, &sent, instance_id));
+        assert!(!reply_matches_probes(&observation, &sent, instance_id + 1));
+        observation.probe_id ^= 1;
+        assert!(!reply_matches_probes(&observation, &sent, instance_id));
+        observation.probe_dst_addr = "52.174.3.88".parse().unwrap();
+        observation.probe_id = observation.checksum(instance_id);
+        assert!(!reply_matches_probes(&observation, &sent, instance_id));
+        observation.probe_dst_addr = destination;
+        observation.probe_ttl = 54;
+        observation.probe_id = observation.checksum(instance_id);
+        assert!(!reply_matches_probes(&observation, &sent, instance_id));
+        observation.probe_ttl = 3;
+        observation.reply_icmp_type = 0;
+        observation.reply_src_addr = destination;
+        observation.probe_id = 0;
+        assert!(reply_matches_probes(&observation, &sent, instance_id));
+        observation.probe_src_port = 4711; // ordinary health ping
+        assert!(!reply_matches_probes(&observation, &sent, instance_id));
+    }
+
+    #[test]
+    fn nms_reply_filter_matches_udp_ports_and_protocol() {
+        let instance_id = 1234;
+        let probe = Probe { dst_addr: "8.8.8.8".parse().unwrap(), src_port: 24000,
+            dst_port: 33434, ttl: 3, protocol: L4::UDP };
+        let sent = HashSet::from([probe_key(&probe)]);
+        let mut observation = reply(3, "8.8.8.8", "8.8.8.8");
+        observation.reply_icmp_type = 3;
+        observation.reply_icmp_code = 3;
+        observation.probe_protocol = 17;
+        observation.probe_src_port = 24000;
+        observation.probe_dst_port = 33434;
+        observation.probe_id = probe.checksum(instance_id);
+        assert!(reply_matches_probes(&observation, &sent, instance_id));
+        observation.probe_dst_port = 33435;
+        assert!(!reply_matches_probes(&observation, &sent, instance_id));
+        observation.probe_dst_port = 33434;
+        observation.probe_protocol = 1;
+        assert!(!reply_matches_probes(&observation, &sent, instance_id));
+    }
+}
