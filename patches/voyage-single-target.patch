+#[test]
+fn single_target_probes_keep_destination_and_distinct_flows_across_rounds() {
+    for protocol in [L4::ICMP, L4::UDP] {
+        for target in ["192.170.0.2", "255.255.255.255", "2001:db8::ffff"] {
+            let destination: IpAddr = target.parse().unwrap();
+            let mut miner = DiamondMiner::new(
+                destination, 1, 4, 24000, 33434, protocol, 95.0, 10,
+            ).single_target();
+            let first = miner.next_round(vec![], false);
+            assert!(!first.is_empty());
+            assert!(first.iter().all(|p| p.dst_addr == destination));
+            for ttl in 1..=4 {
+                let ports: HashSet<_> = first.iter().filter(|p| p.ttl == ttl)
+                    .map(|p| p.src_port).collect();
+                assert_eq!(ports.len(), first.iter().filter(|p| p.ttl == ttl).count());
+                assert!(ports.len() > 1);
+            }
+            // Two observed interfaces force additional flow IDs in round two.
+            let replies = vec![(1, IP[1]), (1, IP[2]), (2, IP[3])].into_iter().map(|(ttl, address)| {
+                let mut observation = reply(ttl, address, DEST[0]);
+                observation.probe_dst_addr = destination;
+                observation
+            }).collect();
+            let second = miner.next_round(replies, false);
+            assert!(!second.is_empty());
+            assert!(second.iter().all(|p| p.dst_addr == destination));
+            for probe in &second {
+                assert!(!first.iter().any(|old| old.ttl == probe.ttl
+                    && old.src_port == probe.src_port));
+            }
+        }
+    }
+}
